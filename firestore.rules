rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerEmail() { return signedIn() && request.auth.token.email == 'christophershelley257@gmail.com'; }
    function isAdmin() { return signedIn(); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /prayer_requests/{requestId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.title is string && request.resource.data.message is string && request.resource.data.email is string && request.resource.data.category is string && request.resource.data.urgent is bool && request.resource.data.prayerCount == 0 && request.resource.data.reportCount == 0 && request.resource.data.answered == false && request.resource.data.status == 'approved';
      allow update: if isAdmin() || (resource.data.status == 'approved' && request.resource.data.diff(resource.data).changedKeys().hasOnly(['prayerCount', 'updatedAt']) && request.resource.data.prayerCount == resource.data.prayerCount + 1) || (resource.data.status == 'approved' && request.resource.data.status == 'reported' && request.resource.data.reportCount == resource.data.reportCount + 1 && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reportCount', 'status', 'updatedAt'])) || (resource.data.status == 'approved' && resource.data.answered != true && request.resource.data.answered == true && request.resource.data.diff(resource.data).changedKeys().hasOnly(['answered', 'answeredAt', 'answeredTestimony', 'updatedAt']) && (!('answeredTestimony' in request.resource.data) || request.resource.data.answeredTestimony is string));
      allow delete: if isAdmin();
    }

    match /reports/{reportId} { allow read, update, delete: if isAdmin(); allow create: if request.resource.data.requestId is string && request.resource.data.email is string && request.resource.data.emailKey is string && request.resource.data.category is string && request.resource.data.reason is string && request.resource.data.status == 'open'; }
    match /report_bans/{banId} { allow get: if true; allow list, create, update, delete: if isAdmin(); }
    match /volunteer_applications/{applicationId} { allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.emailKey is string && request.resource.data.why is string && request.resource.data.status == 'submitted'; allow read, update, delete: if isAdmin(); }
    match /volunteer_invites/{inviteId} { allow get: if true; allow list, create, update, delete: if isAdmin(); }
    match /volunteers/{volunteerId} { allow read: if isSelf(volunteerId) || isAdmin(); allow create: if isSelf(volunteerId); allow update, delete: if isAdmin() || (isSelf(volunteerId) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['agreementAccepted','agreementAcceptedAt','trainingCompleted','trainingCompletedAt','updatedAt'])); }
    match /volunteer_chapter_requests/{chapterId} { allow read: if true; allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.email is string && request.resource.data.emailKey is string && request.resource.data.chapterName is string && request.resource.data.purpose is string && request.resource.data.status == 'submitted'; allow update, delete: if isAdmin(); }
    match /volunteer_chapters/{chapterId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /chapter_members/{memberId} { allow create: if signedIn(); allow read, update, delete: if isAdmin(); }

    match /volunteer_training_plans/{planId} { allow read: if isAdmin() || isSelf(planId); allow create, update, delete: if isAdmin(); }
    match /volunteer_training_completions/{completionId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.reflection is string; allow read, update, delete: if isAdmin(); }

    match /volunteer_activity_updates/{activityId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if isAdmin(); }
    match /volunteer_service_logs/{logId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.summary is string; allow read, update, delete: if isAdmin(); }
    match /volunteer_care_projects/{projectId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.title is string && request.resource.data.purpose is string && request.resource.data.status == 'submitted'; allow read, update, delete: if isAdmin(); }
    match /volunteer_assignments/{assignmentId} { allow read: if isAdmin() || (signedIn() && resource.data.assignedToUid == request.auth.uid); allow create, delete: if isAdmin(); allow update: if isAdmin() || (signedIn() && resource.data.assignedToUid == request.auth.uid && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','completedAt','volunteerResponse','updatedAt'])); }
    match /volunteer_contacts/{contactId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if isAdmin(); }
    match /volunteer_leave_requests/{leaveId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if isAdmin(); }
    match /volunteer_suggestions/{suggestionId} { allow create: if request.resource.data.title is string && request.resource.data.details is string && request.resource.data.status == 'submitted'; allow read, update, delete: if isAdmin(); }
    match /volunteer_announcements/{announcementId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /volunteer_settings/{settingId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /volunteer_notes/{noteId} { allow read, create, update, delete: if isAdmin(); }
    match /volunteer_badges/{badgeId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /chapter_reports/{reportId} { allow create: if signedIn(); allow read, update, delete: if isAdmin(); }
    match /admin_notes/{noteId} { allow read, create, update, delete: if isAdmin(); }

    match /bwr_partner_applications/{applicationId} {
      allow create: if
        request.resource.data.keys().hasAll(['organizationName','organizationType','website','city','state','serviceArea','contactName','contactRole','contactEmail','contactPhone','partnershipTypes','organizationSummary','peopleServed','estimatedBibleNeed','distributionExperience','whyPartner','additionalNotes','dignityAcknowledged','stewardshipAcknowledged','reportingAcknowledged','accuracyAcknowledged','status','source','schemaVersion','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['organizationName','organizationType','website','city','state','serviceArea','contactName','contactRole','contactEmail','contactPhone','partnershipTypes','organizationSummary','peopleServed','estimatedBibleNeed','distributionExperience','whyPartner','additionalNotes','dignityAcknowledged','stewardshipAcknowledged','reportingAcknowledged','accuracyAcknowledged','status','source','schemaVersion','createdAt','updatedAt']) &&
        request.resource.data.organizationName is string && request.resource.data.organizationName.size() >= 2 && request.resource.data.organizationName.size() <= 160 &&
        request.resource.data.organizationType is string && request.resource.data.organizationType.size() >= 2 && request.resource.data.organizationType.size() <= 100 &&
        request.resource.data.website is string && request.resource.data.website.size() <= 300 &&
        request.resource.data.city is string && request.resource.data.city.size() >= 1 && request.resource.data.city.size() <= 100 &&
        request.resource.data.state is string && request.resource.data.state.size() >= 1 && request.resource.data.state.size() <= 100 &&
        request.resource.data.serviceArea is string && request.resource.data.serviceArea.size() >= 2 && request.resource.data.serviceArea.size() <= 300 &&
        request.resource.data.contactName is string && request.resource.data.contactName.size() >= 2 && request.resource.data.contactName.size() <= 120 &&
        request.resource.data.contactRole is string && request.resource.data.contactRole.size() >= 2 && request.resource.data.contactRole.size() <= 120 &&
        request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() >= 5 && request.resource.data.contactEmail.size() <= 220 &&
        request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 60 &&
        request.resource.data.partnershipTypes is list && request.resource.data.partnershipTypes.size() >= 1 && request.resource.data.partnershipTypes.size() <= 7 &&
        request.resource.data.organizationSummary is string && request.resource.data.organizationSummary.size() >= 10 && request.resource.data.organizationSummary.size() <= 1800 &&
        request.resource.data.peopleServed is string && request.resource.data.peopleServed.size() >= 10 && request.resource.data.peopleServed.size() <= 1800 &&
        request.resource.data.estimatedBibleNeed is string && request.resource.data.estimatedBibleNeed.size() <= 100 &&
        request.resource.data.distributionExperience is string && request.resource.data.distributionExperience.size() <= 600 &&
        request.resource.data.whyPartner is string && request.resource.data.whyPartner.size() >= 10 && request.resource.data.whyPartner.size() <= 2200 &&
        request.resource.data.additionalNotes is string && request.resource.data.additionalNotes.size() <= 1800 &&
        request.resource.data.dignityAcknowledged == true &&
        request.resource.data.stewardshipAcknowledged == true &&
        request.resource.data.reportingAcknowledged == true &&
        request.resource.data.accuracyAcknowledged == true &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.source == 'bwr-partners-page' &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /settings/{settingId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /admins/{adminId} { allow read, write: if ownerEmail() || signedIn(); }
    match /{document=**} { allow read, write: if false; }
  }
}
