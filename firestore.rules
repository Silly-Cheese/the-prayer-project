rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /prayer_requests/{requestId} {
      allow read: if true;

      allow create: if true;

      allow update: if true;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
